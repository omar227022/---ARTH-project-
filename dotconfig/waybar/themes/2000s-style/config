{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 4,

    "modules-left": ["custom/launcher", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "pulseaudio", "network", "tray"],

    "custom/launcher": {
        "format": "󰀻 ",
        "on-click": "wofi --show drun "
    },

    "mpris": {
        "format": "󰝚  {artist} - {title} ",
        "format-paused": "󰏤  {artist} - {title} ",
        "max-length": 30,
        "on-click": "playerctl play-pause"
    },

    "network": {
        "format-wifi": " ",
        "format-ethernet": "󰈀 ",
        "format-disconnected": "󰖪 ",
        "tooltip-format": "{essid} ({signalStrength}%)"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "󱑂  {:%I:%M %p}"
    }
}
